    "/v1/alerts": {
      "get": {
        "operationId": "AlertsController_list",
        "parameters": [
          {
            "description": "Return only unprocessed alerts",
            "in": "query",
            "name": "unprocessed",
            "required": false,
            "schema": {
              "type": "boolean"
