# Dependencies
node_modules/

# Environment (contains API keys and private keys)
.env
scripts/.env

# New service runtime env (P-prep onward) — block real values, allow examples
.env.runtime
secrets/signer.env
secrets/*.env
!secrets/*.env.example
!.env.runtime.example

# Wallet databases (per-fund, not code)
data/
*.db
*.db-wal
*.db-shm

# OS files
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log

# TypeScript build output (P0 monorepo)
# dist/ is produced by tsc --build; committed only for SDK generated files
apps/*/dist/
libs/*/dist/
libs/modules/*/dist/
libs/adapters/*/dist/
sdk/cclaw/dist/

# Compiled JS artefacts that must not land in src/ (leftover from earlier outDir misconfiguration)
# tsc --build now writes exclusively to dist/; any .js/.d.ts in src/ is a stale leftover.
# Applies to all libs/*/src/ trees (config, logger, prisma, auth, audit, health, modules/*).
libs/*/src/**/*.js
libs/*/src/**/*.js.map
libs/*/src/**/*.d.ts
libs/*/src/**/*.d.ts.map
libs/modules/*/src/**/*.js
libs/modules/*/src/**/*.js.map
libs/modules/*/src/**/*.d.ts
libs/modules/*/src/**/*.d.ts.map
libs/adapters/*/src/**/*.js
libs/adapters/*/src/**/*.js.map
libs/adapters/*/src/**/*.d.ts
libs/adapters/*/src/**/*.d.ts.map

# TypeScript incremental build info
*.tsbuildinfo

# Vitest coverage output (build artifact — never commit)
coverage/

# Stray SQLite artifacts created by integration specs that parse `file::*` URIs literally
prisma/:*
