# =============================================================================
# CryptoClaw — .env.runtime.example
# -----------------------------------------------------------------------------
# Copy to `.env.runtime` and fill in your values.
#
# Mode: 0600. Owner: deploy user. Never commit; .gitignore + pre-commit-check
# enforce. Loaded by api / worker / scheduler containers.
#
# Forbidden in this file: SAFE_SIGNER_KEY, SQUADS_SIGNER_KEY. Those live in
# `secrets/signer.env` (mode 0400) and are mounted only into the worker
# container for spawn-time injection into apps/executor.
# =============================================================================

# Logger output level — fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Runtime mode — development | production | test (default: development).
# Production disables pino-pretty and emits JSON-only logs.
NODE_ENV=production

# -----------------------------------------------------------------------------
# Fund identity
# -----------------------------------------------------------------------------
# SAFE_ID — selects the SQLite filename (data/<SAFE_ID>.db). Required.
SAFE_ID=fund-alpha

# DB_PATH — defaults to ./data/<SAFE_ID>.db. Override only for non-standard mounts.
# DB_PATH=./data/fund-alpha.db


# -----------------------------------------------------------------------------
# Bearer tokens — per-identity, role: agent (RW)
# Generate with: `openssl rand -base64 32 | tr -d '/+=' | head -c 32`
# All tokens 32-char URL-safe random. Required by the api boot self-check.
# -----------------------------------------------------------------------------
RESEARCH_API_KEY=
SENTINEL_API_KEY=
EXECUTOR_API_KEY=
OBSERVER_API_KEY=
LOOP_API_KEY=
WORKER_API_KEY=
SCHEDULER_API_KEY=

# Bearer token — role: dashboard (RO). No consumer in this phase but the
# api boot still requires it to be set so future frontends can be wired
# without restart sequencing.
DASHBOARD_API_KEY=


# -----------------------------------------------------------------------------
# Redis (BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379


# -----------------------------------------------------------------------------
# Active chains
# -----------------------------------------------------------------------------
# Comma-separated. Solana sync exits gracefully if Squads not configured.
ACTIVE_CHAINS=base,ethereum,solana


# -----------------------------------------------------------------------------
# Paper mode
# -----------------------------------------------------------------------------
PAPER_MODE=false
PAPER_STARTING_BALANCE=10000
# Per-chain overrides
# PAPER_STARTING_BALANCE_BASE=5000
# PAPER_STARTING_BALANCE_SOLANA=5000
# PAPER_STARTING_BALANCE_ETHEREUM=5000


# -----------------------------------------------------------------------------
# Auto-approve BUY orders (real mode only)
# -----------------------------------------------------------------------------
# AUTO_APPROVE_BUY=true requires AUTO_APPROVE_BUY_MAX_USD to be a positive number.
# Orders above the cap fall back to status='pending' (human-gated).
AUTO_APPROVE_BUY=false
# AUTO_APPROVE_BUY_MAX_USD=50




# -----------------------------------------------------------------------------
# Executor subprocess (P1c-i) — consumed by apps/worker
# FORBIDDEN in this file: SAFE_SIGNER_KEY, SQUADS_SIGNER_KEY
# Those live in secrets/signer.env (mode 0400, worker-only mount per ADR-0023)
# -----------------------------------------------------------------------------

# Path to the executor binary (default: auto-resolved from monorepo structure).
# Override for non-standard Docker layouts.
# EXECUTOR_BIN_PATH=/app/apps/executor/dist/main.js

# Stub mode: returns fake receipts instead of real Safe/Squads txs.
# MUST be 0 or unset in production. Set to 1 for local dev/testing only.
EXECUTOR_STUB_MODE=0

# Path to signer env file (default: /run/secrets/signer.env).
# Worker mounts secrets/ at this path. Change only if deploying with a
# non-standard secrets mount layout.
SIGNER_ENV_FILE=/run/secrets/signer.env


# -----------------------------------------------------------------------------
# P1c-ii: real Safe EVM SDK execution — RPC endpoints, Safe addresses, validation
# These six fields are consumed by apps/executor when EXECUTOR_STUB_MODE=0.
# Leave blank to disable real-mode execution for a given chain.
# -----------------------------------------------------------------------------

# RPC URL for Base chain (required when ACTIVE_CHAINS includes 'base').
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# RPC URL for Ethereum mainnet (required when ACTIVE_CHAINS includes 'ethereum').
RPC_ETH=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# RPC URL for Solana (required when ACTIVE_CHAINS includes 'solana').
# P1c-iii: In production, use Helius or Quicknode — the public api.mainnet-beta.solana.com
# has aggressive rate limits incompatible with production swap traffic.
# Example: RPC_SOL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_SOL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Safe multisig address on Base (leave blank to disable Base real-mode execution).
SAFE_ADDRESS_BASE=

# Safe multisig address on Ethereum mainnet (leave blank to disable ETH real-mode execution).
SAFE_ADDRESS_ETH=

# RPC hostname allowlist enforcement mode.
# strict (default) — fail-closed: reject RPCs whose hostname is not in the allowlist.
# warn             — log a warning but allow the request (rollout / new-provider mode).
# skip             — bypass the check entirely (use only during a genuine outage).
RPC_VALIDATION_MODE=strict


# -----------------------------------------------------------------------------
# Per-tier USD ceilings (overrides chains.js defaults)
# -----------------------------------------------------------------------------
# TIER_MAX_USD_MOONSHOT=200
# TIER_MAX_USD_CONVICTION=500
# TIER_MAX_USD_BASE=2000


# -----------------------------------------------------------------------------
# Pre-execute safety toggles — leave defaults unless a vendor outage forces
# a temporary skip. All four default to "checks enforced".
# -----------------------------------------------------------------------------
# SKIP_PRESIGN_RECHECK=false
# SKIP_CASH_RECONCILE=false
# SKIP_PRICE_ORACLE=false
# SKIP_TWO_SOURCE_CONFIRM=false


# -----------------------------------------------------------------------------
# ERC-20 approval margin (EVM only)
# -----------------------------------------------------------------------------
# Default 5%. Use 10 for high-volatility assets. Costs ~$3 extra gas per buy.
# APPROVAL_MARGIN_PCT=5


# -----------------------------------------------------------------------------
# Token-age quarantine
# -----------------------------------------------------------------------------
# Default 24h. 0 disables, 12 relaxes, 48 tightens.
# QUARANTINE_TOKEN_AGE_HOURS=24


# -----------------------------------------------------------------------------
# Multisig governance drift expectations
# Set per chain. Daily cron alerts on owner-add or threshold-lower.
# -----------------------------------------------------------------------------
# EVM
# EXPECTED_SAFE_OWNERS_BASE=0xowner1,0xowner2,0xowner3
# EXPECTED_SAFE_THRESHOLD_BASE=2
# EXPECTED_SAFE_MODULES_BASE=
# EXPECTED_SAFE_OWNERS_ETHEREUM=0xowner1,0xowner2,0xowner3
# EXPECTED_SAFE_THRESHOLD_ETHEREUM=2
# EXPECTED_SAFE_MODULES_ETHEREUM=

# Solana Squads
# EXPECTED_SQUADS_MEMBERS=Pubkey1,Pubkey2,Pubkey3
# EXPECTED_SQUADS_THRESHOLD=2


# -----------------------------------------------------------------------------
# Squads multisig (Solana) — P1c-iii: addresses only, no signer key here.
# Signer key lives in secrets/signer.env (mode 0400, worker-only mount per ADR-0023).
# Both SQUADS_MULTISIG_ADDRESS and SQUADS_VAULT_ADDRESS are required for real-mode
# Solana execution (SQUADS_MULTISIG_ADDRESS is needed for Squads V4 instruction building
# even when SQUADS_VAULT_ADDRESS is set directly).
# -----------------------------------------------------------------------------
# SQUADS_VAULT_ADDRESS takes priority for vault resolution. If unset, vault is derived
# from SQUADS_MULTISIG_ADDRESS using the configured vaultIndex (default: 0).
SQUADS_VAULT_ADDRESS=
SQUADS_MULTISIG_ADDRESS=


# -----------------------------------------------------------------------------
# Background pipeline job tuning (P3g1) — wallet harvest / scoring / activity
# -----------------------------------------------------------------------------

# Wall-clock cap (ms) for one wallet-harvest job invocation (default: 300000 = 5 min).
# Raise if Birdeye is legitimately slow on a large ACTIVE_CHAINS list.
# WALLET_HARVEST_TIMEOUT_MS=300000

# Per-wallet AbortController timeout (ms) for Birdeye+Zerion calls in the scoring cycle
# (default: 30000 = 30 s, matches legacy execFileSync 30s timeout in score-wallets-bg.js).
# WALLET_SCORING_PER_WALLET_TIMEOUT_MS=30000

# Delay between wallets in a scoring cycle (ms) for rate-limit respect
# (default: 3000 = 3 s, matches legacy DELAY_MS in score-wallets-bg.js).
# WALLET_SCORING_INTER_WALLET_DELAY_MS=3000

# Per-fetch AbortSignal deadline (ms) for Helius/Etherscan calls in the activity cycle
# (default: 10000 = 10 s, matches legacy FETCH_TIMEOUT_MS in activity-wallets-bg.js).
# WALLET_ACTIVITY_PER_FETCH_TIMEOUT_MS=10000

# Consecutive timeout threshold before skipping remaining wallets on a chain this cycle
# (default: 5, matches legacy FAIL_FAST_CONSECUTIVE in activity-wallets-bg.js).
# WALLET_ACTIVITY_PER_CHAIN_TIMEOUT_LIMIT=5

# Delay between wallets within a chain in an activity cycle (ms)
# (default: 250, matches legacy PER_CHAIN_DELAY_MS in activity-wallets-bg.js).
# WALLET_ACTIVITY_INTER_WALLET_DELAY_MS=250


# -----------------------------------------------------------------------------
# Data API keys
# -----------------------------------------------------------------------------
GOPLUS_API_KEY=
# EVM explorer API keys — used by EvmExplorerAdapter (P3g1 PR-C) for wallet activity polling.
# Each is optional: the activity processor skips wallets on chains whose key is absent.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
# ARBISCAN_API_KEY=
# POLYGONSCAN_API_KEY=
# BSCSCAN_API_KEY=
# OPTIMISTIC_ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
HELIUS_API_KEY=
ZERION_API_KEY=
BIRDEYE_API_KEY=
DEBANK_API_KEY=
ONEINCH_API_KEY=
# DEXSCREENER_API_KEY=    # free tier, no key needed
# COINGECKO_API_KEY=      # free tier, no key needed for basic data
# JUPITER_API_KEY=        # free tier, optional for higher limits


# -----------------------------------------------------------------------------
# OpenAI / Ollama (agent models)
# Codex OAuth (preferred): one-time `openclaw models auth login --provider openai-codex`
# OPENAI_API_KEY is the static-key fallback.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OLLAMA_API_KEY=

RESEARCH_MODEL=openai-codex/gpt-5.5
SENTINEL_MODEL=openai-codex/gpt-5.5
EXECUTOR_MODEL=openai-codex/gpt-5.5
OBSERVER_MODEL=openai-codex/gpt-5.5

SENTINEL_MODEL_FALLBACK=anthropic/claude-haiku-4-5-20251001
EXECUTOR_MODEL_FALLBACK=anthropic/claude-haiku-4-5-20251001

EMERGENCY_AFTER=3


# -----------------------------------------------------------------------------
# OpenClaw gateway
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BIND=lan


# -----------------------------------------------------------------------------
# Telegram
# Without ENABLE_CHANNELS=true, Telegram is outbound-only (alerts).
# -----------------------------------------------------------------------------
ENABLE_CHANNELS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
TELEGRAM_APPROVAL_BOT_TOKEN=

# Forum topic thread IDs — discover with `telegram-get-topics`.
TG_TOPIC_RESEARCH=
TG_TOPIC_SENTINEL=
TG_TOPIC_EXECUTOR=
TG_TOPIC_ALERTS=
TG_TOPIC_SYSTEM=
TG_TOPIC_OBSERVER=
TG_TOPIC_PORTFOLIO=
TG_TOPIC_APPROVALS=
PORTFOLIO_REPORT_HOUR=0


# -----------------------------------------------------------------------------
# Agent memory backup (optional git remote)
# -----------------------------------------------------------------------------
# MEMORY_GIT_REMOTE=https://<token>@github.com/you/crypto-claw-memory.git


# -----------------------------------------------------------------------------
# Observer agent — GitHub integration (optional)
# -----------------------------------------------------------------------------
# OBSERVER_ISSUES_REPO=you/crypto-claw-issues
# GH_TOKEN=ghp_...


# -----------------------------------------------------------------------------
# cclaw CLI (consumed by the agents container)
# -----------------------------------------------------------------------------
# Where to reach the api from the agents container (P6: apps-api service name)
CCLAW_API_BASE=http://apps-api:7878
# Per-agent token: set CCLAW_API_TOKEN to the appropriate *_API_KEY value
# in each agent's environment via docker-compose.yml. Do not put it in this
# shared file.

# Position-reconcile drift threshold (percent). Default: 1
RECONCILE_TOLERANCE_PCT=1
# DEXScreener bulk-price fetch timeout (ms). Default: 15000
DEXSCREENER_TIMEOUT_MS=15000
# Reserved for future DeBank adapter (unconsumed in PR-E)
# DEBANK_ACCESS_KEY=


# -----------------------------------------------------------------------------
# P6: Production compose deployment
# -----------------------------------------------------------------------------

# NestJS image digest — published by main.yml to GHCR.
# Use the sha-tagged image for immutable deployments.
# Example: ghcr.io/0xb11a/crypto-claw:sha-abc1234
CRYPTO_CLAW_IMAGE=ghcr.io/0xb11a/crypto-claw:sha-<7chars>

# API bind address (P6 compose addendum to ADR-0006).
# 0.0.0.0 inside the compose network; no host port is published.
API_BIND_ADDRESS=0.0.0.0

# Prisma repo root: /app in the prod image (resolves prisma/ and node_modules/.bin/prisma)
PRISMA_REPO_ROOT=/app
