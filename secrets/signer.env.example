# =============================================================================
# CryptoClaw — secrets/signer.env.example
# -----------------------------------------------------------------------------
# Copy to `secrets/signer.env` and fill in your values.
#
# Mode: 0400. Owner: deploy user. Never commit; .gitignore + pre-commit-check
# enforce.
#
# This file is mounted **only into the worker container** at /run/secrets,
# read-only. apps/executor reads it at spawn time via libs/execution/spawn.
# It must NEVER be referenced from .env.runtime, never logged, never echoed,
# and never present in `apps/api`, `apps/worker`, or `apps/scheduler`'s
# process environment (boot self-check exits if it is).
# =============================================================================


# -----------------------------------------------------------------------------
# EVM signer — Safe wallet executor key
# -----------------------------------------------------------------------------
# Hex-encoded private key (64 chars, with or without 0x prefix).
# Used by apps/executor to build, sign, and submit Safe transactions on
# Ethereum and Base.
SAFE_SIGNER_KEY=


# -----------------------------------------------------------------------------
# Solana signer — Squads vault executor key
# -----------------------------------------------------------------------------
# Base58-encoded private key (87-88 chars).
# Used by apps/executor to build, sign, and submit Squads transactions on Solana.
SQUADS_SIGNER_KEY=
