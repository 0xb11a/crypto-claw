{
  "$schema": "https://openclaw.ai/schemas/config.json",
  "version": "2026.3",
  "description": "CryptoClaw Executor Agent — signs and submits Safe wallet transactions",

  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5-20251001",
        "fallbacks": []
      },
      "maxTokens": 1024,
      "temperature": 0.0
    }
  },

  "heartbeat": {
    "every": "1m",
    "target": "last",
    "model": "anthropic/claude-haiku-4-5-20251001",
    "activeHours": {
      "start": "00:00",
      "end": "23:59",
      "timezone": "UTC"
    },
    "prompt": "Read HEARTBEAT.md. Process pending sell orders FIRST (node scripts/db-query.js get-sell-orders --pending), then approved trades (node scripts/db-query.js get-approved-trades --pending), then check queued receipts. Validate every order before signing. Write receipts via db-query.js. If nothing to process, reply HEARTBEAT_OK. Keep response under 300 tokens."
  },

  "tools": {
    "shell": {
      "enabled": true,
      "allowedCommands": [
        "node scripts/db-query.js *",
        "node scripts/execute-trade.js",
        "node scripts/check-safe-status.js"
      ]
    },
    "fetch": {
      "enabled": true,
      "allowedDomains": [
        "safe-transaction-mainnet.safe.global",
        "safe-transaction-base.safe.global",
        "api.1inch.dev",
        "api.0x.org",
        "quote-api.jup.ag",
        "api.dexscreener.com"
      ]
    },
    "browser": { "enabled": false }
  },

  "permissions": {
    "autoApprove": {
      "read": true,
      "write": [
        "workspace/memory/*"
      ],
      "shell": [
        "node scripts/db-query.js *",
        "node scripts/execute-trade.js",
        "node scripts/check-safe-status.js"
      ],
      "fetch": true
    },
    "requireApproval": {
      "write": ["workspace/AGENTS.md", "workspace/SOUL.md", "openclaw.json"],
      "shell": ["rm *", "mv *"]
    }
  },

  "channels": {
    "telegram": {
      "enabled": true,
      "alertPriority": {
        "critical": "immediate",
        "high": "immediate",
        "medium": "immediate",
        "low": "batch_hourly"
      }
    }
  },

  "security": {
    "promptInjectionProtection": true,
    "blockConfigModification": true,
    "auditLog": true
  }
}
