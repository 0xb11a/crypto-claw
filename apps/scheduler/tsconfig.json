{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@cclaw/config": ["../../libs/config/src/index.ts"],
      "@cclaw/logger": ["../../libs/logger/src/index.ts"],
      "@cclaw/wallets": ["../../libs/modules/wallets/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../libs/config" },
    { "path": "../../libs/logger" },
    { "path": "../../libs/modules/wallets" }
  ]
}
