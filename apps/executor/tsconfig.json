{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@cclaw/config": ["../../libs/config/src/index.ts"],
      "@cclaw/chain": ["../../libs/chain/src/index.ts"],
      "@cclaw/execution": ["../../libs/execution/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../../libs/config" }, { "path": "../../libs/chain" }, { "path": "../../libs/execution" }]
}
