{
  "name": "crypto-claw",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --build",
    "lint": "eslint 'apps/**/*.ts' && eslint 'libs/modules/**/*.ts' 'libs/adapters/**/*.ts' && eslint 'libs/audit/**/*.ts' 'libs/auth/**/*.ts' 'libs/chain/**/*.ts' 'libs/config/**/*.ts' 'libs/domain/**/*.ts' 'libs/execution/**/*.ts' 'libs/health/**/*.ts' 'libs/logger/**/*.ts' 'libs/market/**/*.ts' 'libs/notifications/**/*.ts' 'libs/portfolio/**/*.ts' 'libs/prisma/**/*.ts' 'sdk/**/*.ts' && eslint 'scripts/**/*.js' 'tests/**/*.js'",
    "lint:fix": "eslint --fix 'apps/**/*.ts' && eslint --fix 'libs/modules/**/*.ts' 'libs/adapters/**/*.ts' && eslint --fix 'libs/audit/**/*.ts' 'libs/auth/**/*.ts' 'libs/chain/**/*.ts' 'libs/config/**/*.ts' 'libs/domain/**/*.ts' 'libs/execution/**/*.ts' 'libs/health/**/*.ts' 'libs/logger/**/*.ts' 'libs/market/**/*.ts' 'libs/notifications/**/*.ts' 'libs/portfolio/**/*.ts' 'libs/prisma/**/*.ts' 'sdk/**/*.ts' && eslint --fix 'scripts/**/*.js' 'tests/**/*.js'",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project '*:unit'",
    "test:integration": "vitest run --project 'integration' --no-file-parallelism",
    "test:e2e": "vitest run --project 'e2e'",
    "build": "tsc --build",
    "build:openapi": "tsx tools/build-openapi.ts",
    "build:sdk": "tsx tools/build-sdk.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "dev:scheduler": "tsx apps/scheduler/src/main.ts",
    "dev:executor": "tsx apps/executor/src/main.ts",
    "legacy:lint": "eslint 'scripts/**/*.js' 'tests/**/*.js'",
    "legacy:test": "cd tests && node run-all.js --offline",
    "check:vitest-workspace": "node scripts/ci/check-vitest-workspace.mjs",
    "check:dockerfile-modules": "node scripts/ci/check-dockerfile-modules.mjs"
  },
  "lint-staged": {
    "{apps,libs,sdk}/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@swc/core": "^1.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.29.0",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-fastify": "^10.4.22",
    "@nestjs/swagger": "^7.0.0",
    "@nestjs/terminus": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.0",
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "commander": "^14.0.3",
    "fastify": "^4.0.0",
    "helmet": "^8.1.0",
    "openapi-typescript-codegen": "^0.30.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
