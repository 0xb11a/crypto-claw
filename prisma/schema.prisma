// Prisma schema for CryptoClaw — mirrors legacy scripts/db.js migrations 001-027.
// Source of truth for column types/names: scripts/db.js (read-only; do NOT modify it).
// JSON-string columns are typed as String to match the on-disk SQLite shape.
// The _migrations table used by the legacy db.js migration runner is left out of
// Prisma ownership entirely (Prisma uses _prisma_migrations, legacy uses _migrations
// — different tables, no conflict).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// positions — migration 001 + 008 + 011 + 015 + 016 + 018
// ---------------------------------------------------------------------------

model Position {
  id                 String  @id
  symbol             String
  name               String?
  address            String
  chain              String
  tier               String
  entryPrice         Float   @map("entry_price")
  currentPrice       Float?  @map("current_price")
  quantity           Float
  valueUsd           Float?  @map("value_usd")
  percentOfPortfolio Float?  @map("percent_of_portfolio")
  entryDate          String  @map("entry_date")
  stopLoss           Float   @map("stop_loss")
  takeProfitLevels   String  @map("take_profit_levels") // JSON array (String, not Json)
  narrative          String?
  status             String  @default("open")
  notes              String?
  onchainBalance     Float?  @map("onchain_balance")
  lastSyncedAt       String? @map("last_synced_at")
  exitPrice          Float?  @map("exit_price")
  exitDate           String? @map("exit_date")
  pnlPercent         Float?  @map("pnl_percent")
  pnlUsd             Float?  @map("pnl_usd")
  exitReason         String? @map("exit_reason")
  maxPriceSinceEntry Float?  @map("max_price_since_entry")
  trailingStopPct    Float?  @map("trailing_stop_pct")
  trailingStopActive Int     @default(0) @map("trailing_stop_active")
  tpLevelsHit        String  @default("[]") @map("tp_levels_hit") // JSON array
  createdAt          String? @map("created_at")
  updatedAt          String? @map("updated_at")

  @@index([status], name: "idx_positions_status")
  @@index([chain], name: "idx_positions_chain")
  @@index([address, chain], name: "idx_positions_address_chain")
  @@map("positions")
}

// ---------------------------------------------------------------------------
// paper_positions — migration 002 + 018
// ---------------------------------------------------------------------------

model PaperPosition {
  id                 String  @id
  symbol             String
  address            String
  chain              String
  tier               String
  entryPrice         Float   @map("entry_price")
  currentPrice       Float?  @map("current_price")
  quantity           Float
  valueUsd           Float?  @map("value_usd")
  entryDate          String  @map("entry_date")
  stopLoss           Float   @map("stop_loss")
  takeProfitLevels   String  @map("take_profit_levels") // JSON array
  status             String  @default("open")
  exitPrice          Float?  @map("exit_price")
  exitDate           String? @map("exit_date")
  pnlPercent         Float?  @map("pnl_percent")
  pnlUsd             Float?  @map("pnl_usd")
  exitReason         String? @map("exit_reason")
  maxPriceSinceEntry Float?  @map("max_price_since_entry")
  trailingStopPct    Float?  @map("trailing_stop_pct")
  trailingStopActive Int     @default(0) @map("trailing_stop_active")
  tpLevelsHit        String  @default("[]") @map("tp_levels_hit") // JSON array
  createdAt          String? @map("created_at")
  updatedAt          String? @map("updated_at")

  @@index([status], name: "idx_paper_positions_status")
  @@index([address, chain], name: "idx_paper_positions_address_chain")
  @@map("paper_positions")
}

// ---------------------------------------------------------------------------
// orders — migration 012 + 014 + 016 + 022 + 027
// ---------------------------------------------------------------------------

model Order {
  id                 String  @id
  action             String
  symbol             String
  name               String?
  address            String
  chain              String
  amount             String
  percentOfPortfolio Float?  @map("percent_of_portfolio")
  tier               String?
  entryPrice         Float?  @map("entry_price")
  stopLoss           Float?  @map("stop_loss")
  takeProfitLevels   String? @map("take_profit_levels") // JSON array
  analysisScore      Int?    @map("analysis_score")
  riskScore          Int?    @map("risk_score")
  reasoning          String?
  reason             String?
  urgency            String?
  approvedAt         String? @map("approved_at")
  approvedBy         String? @map("approved_by")
  status             String  @default("pending")
  statusReason       String? @map("status_reason")
  statusChangedAt    String? @map("status_changed_at")
  statusChangedBy    String? @map("status_changed_by")
  updatedAt          String? @map("updated_at")
  tgMessageId        Int?    @map("tg_message_id")
  createdAt          String? @map("created_at")

  @@index([status], name: "idx_orders_status")
  @@index([action], name: "idx_orders_action")
  @@index([address, chain], name: "idx_orders_address_chain")
  @@map("orders")
}

// ---------------------------------------------------------------------------
// receipts — migration 012 + 015 + 016
// ---------------------------------------------------------------------------

model Receipt {
  id                  String  @id
  orderId             String  @map("order_id")
  action              String
  symbol              String
  address             String
  chain               String
  amount              Float?
  quantity            Float?
  expectedPrice       Float?  @map("expected_price")
  executedPrice       Float?  @map("executed_price")
  slippage            Float?
  status              String
  safeTxHash          String? @map("safe_tx_hash")
  onchainTxHash       String? @map("onchain_tx_hash")
  safeNonce           Int?    @map("safe_nonce")
  signaturesCollected Int?    @map("signatures_collected")
  signaturesRequired  Int?    @map("signatures_required")
  gasUsed             String? @map("gas_used")
  error               String?
  notes               String?
  positionId          String? @map("position_id")
  createdAt           String? @map("created_at")

  @@index([orderId], name: "idx_receipts_order_id")
  @@index([status], name: "idx_receipts_status")
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// paper_receipts — migration 012
// ---------------------------------------------------------------------------

model PaperReceipt {
  id               String  @id
  orderId          String  @map("order_id")
  action           String
  symbol           String
  address          String
  chain            String
  tier             String?
  proposedPrice    Float   @map("proposed_price")
  quantity         Float?
  amount           Float?
  stopLoss         Float?  @map("stop_loss")
  takeProfitLevels String? @map("take_profit_levels") // JSON array
  reasoning        String?
  pnlPercent       Float?  @map("pnl_percent")
  pnlUsd           Float?  @map("pnl_usd")
  createdAt        String? @map("created_at")

  @@index([orderId], name: "idx_paper_receipts_order_id")
  @@map("paper_receipts")
}

// ---------------------------------------------------------------------------
// sentinel_alerts — migration 001
// ---------------------------------------------------------------------------

model SentinelAlert {
  id           String  @id
  symbol       String
  chain        String
  alertType    String  @map("alert_type")
  severity     String
  currentPrice Float?  @map("current_price")
  triggerPrice Float?  @map("trigger_price")
  details      String?
  action       String?
  sellAmount   String? @map("sell_amount")
  processed    Int     @default(0)
  processedAt  String? @map("processed_at")
  createdAt    String? @map("created_at")

  @@index([processed], name: "idx_sentinel_alerts_processed")
  @@map("sentinel_alerts")
}

// ---------------------------------------------------------------------------
// heartbeat_state — migration 001
// ---------------------------------------------------------------------------

model HeartbeatState {
  agent     String
  checkType String  @map("check_type")
  lastRun   String? @map("last_run")

  @@id([agent, checkType])
  @@map("heartbeat_state")
}

// ---------------------------------------------------------------------------
// portfolio_meta — migration 001 (key-value store used across the codebase)
// ---------------------------------------------------------------------------

model PortfolioMeta {
  key       String  @id
  value     String
  updatedAt String? @map("updated_at")

  @@map("portfolio_meta")
}

// ---------------------------------------------------------------------------
// service_audit — new table introduced in P1a (SPEC §9.5, ADR-0018)
// ---------------------------------------------------------------------------

model ServiceAudit {
  id           String  @id @default(cuid())
  ts           String  @default("")
  identity     String
  role         String
  method       String
  path         String
  bodySha256   String  @map("body_sha256")
  bodyRedacted String? @map("body_redacted")
  status       Int
  latencyMs    Int     @map("latency_ms")
  errorKind    String? @map("error_kind")

  @@index([identity, ts])
  @@index([path, ts])
  @@map("service_audit")
}

// ---------------------------------------------------------------------------
// tracked_wallets — migrations 001 + 003 + 004 + 007 + 024 (smart-money pipeline)
// ---------------------------------------------------------------------------

model TrackedWallet {
  address        String
  chain          String
  label          String?
  /// smart_money | dev | whale | deployer | trader | retail (NULL = unscored)
  type           String?
  notes          String?
  status         String  @default("proposed") // proposed | scoring | scored | failed
  score          Int?
  /// JSON-as-string; stored raw (bug-for-bug parity with db-query.js)
  scoreBreakdown String? @map("score_breakdown")
  sourceToken    String? @map("source_token")
  scoredAt       String? @map("scored_at")
  scoreError     String? @map("score_error")
  retryCount     Int     @default(0) @map("retry_count")
  source         String? @default("agent")
  lastCheckedAt  String? @map("last_checked_at")
  createdAt      String? @map("created_at")

  @@id([address, chain])
  // Covers findActivityCandidates: WHERE type='smart_money' AND status='scored' ORDER BY lastCheckedAt
  @@index([type, status, lastCheckedAt])
  // Covers findUnscored: WHERE status='proposed' OR (status='failed' AND retryCount<3) ORDER BY createdAt
  @@index([status, retryCount, createdAt])
  @@map("tracked_wallets")
}

// ---------------------------------------------------------------------------
// smart_money_signals — migration 024
// ---------------------------------------------------------------------------

model SmartMoneySignal {
  id                  Int     @id @default(autoincrement())
  txHash              String  @map("tx_hash")
  chain               String
  walletAddress       String  @map("wallet_address")
  walletScore         Int?    @map("wallet_score")
  walletLabel         String? @map("wallet_label")
  /// buy | sell
  action              String
  tokenAddress        String  @map("token_address")
  tokenSymbol         String? @map("token_symbol")
  counterTokenAddress String? @map("counter_token_address")
  counterTokenSymbol  String? @map("counter_token_symbol")
  amountToken         String? @map("amount_token")
  txTimestamp         String  @map("tx_timestamp")
  createdAt           String? @map("created_at")

  @@unique([txHash, walletAddress, action, tokenAddress])
  @@index([createdAt], map: "idx_smart_money_signals_created_at")
  @@index([tokenAddress, chain, createdAt], map: "idx_smart_money_signals_token")
  @@index([chain, createdAt], map: "idx_smart_money_signals_chain")
  @@map("smart_money_signals")
}

// ---------------------------------------------------------------------------
// liquidity_snapshots — migration 001
// ---------------------------------------------------------------------------

model LiquiditySnapshot {
  id           Int     @id @default(autoincrement())
  address      String
  chain        String
  liquidityUsd Float   @map("liquidity_usd")
  checkedAt    String? @map("checked_at")

  @@index([address, chain], map: "idx_liquidity_address")
  @@map("liquidity_snapshots")
}

// ---------------------------------------------------------------------------
// watchlist — migration 001
// ---------------------------------------------------------------------------

model Watchlist {
  id            String  @id
  symbol        String
  address       String
  chain         String
  targetEntry   Float?  @map("target_entry")
  currentPrice  Float?  @map("current_price")
  analysisScore Int?    @map("analysis_score")
  riskScore     Int?    @map("risk_score")
  narrative     String?
  reason        String?
  expiresAt     String? @map("expires_at")
  status        String  @default("watching") // watching | entry_hit | expired | removed
  createdAt     String? @map("created_at")
  updatedAt     String? @map("updated_at")

  @@index([status], map: "idx_watchlist_status")
  @@index([address, chain], map: "idx_watchlist_address_chain")
  @@map("watchlist")
}

// ---------------------------------------------------------------------------
// research_log — migration 019 (P2 group 2)
// ---------------------------------------------------------------------------

model ResearchLog {
  id              Int     @id @default(autoincrement())
  checkType       String  @map("check_type")
  tokensScanned   Int     @default(0) @map("tokens_scanned")
  tokensAnalyzed  Int     @default(0) @map("tokens_analyzed")
  tradesProposed  Int     @default(0) @map("trades_proposed")
  alertsProcessed Int     @default(0) @map("alerts_processed")
  watchlistHits   Int     @default(0) @map("watchlist_hits")
  summary         String?
  status          String  @default("ok")
  /// created_at is a String? matching the SQLite DEFAULT (datetime('now')) format
  /// (e.g. "2026-05-13 10:30:00" — non-Z ISO). Omit in create so SQLite default fires.
  createdAt       String? @map("created_at")

  @@index([createdAt])
  @@map("research_log")
}

// ---------------------------------------------------------------------------
// sentinel_log — migration 001 + 026 (P2 group 2)
// ---------------------------------------------------------------------------

model SentinelLog {
  id               Int     @id @default(autoincrement())
  checkType        String  @map("check_type")
  positionsChecked Int     @default(0) @map("positions_checked")
  alertsGenerated  Int     @default(0) @map("alerts_generated")
  sellsExecuted    Int     @default(0) @map("sells_executed")
  status           String  @default("ok")
  /// summary column added by migration 026 (was missing pre-026). Omit in
  /// legacy SQLite rows — those NULL values survive the ALTER TABLE correctly.
  summary          String?
  /// created_at is a String? matching the SQLite DEFAULT (datetime('now')) format.
  /// Omit in create so SQLite default fires (bug-for-bug parity with db-query.js).
  createdAt        String? @map("created_at")

  @@index([createdAt])
  @@map("sentinel_log")
}

// ---------------------------------------------------------------------------
// executor_log — migration 001 + 026 (P2 group 2)
// ---------------------------------------------------------------------------

model ExecutorLog {
  id                  Int     @id @default(autoincrement())
  sellOrdersProcessed Int     @default(0) @map("sell_orders_processed")
  buyOrdersProcessed  Int     @default(0) @map("buy_orders_processed")
  pendingChecked      Int     @default(0) @map("pending_checked")
  successCount        Int     @default(0) @map("success_count")
  failCount           Int     @default(0) @map("fail_count")
  queuedCount         Int     @default(0) @map("queued_count")
  status              String  @default("ok")
  /// summary column added by migration 026. See sentinel_log note above.
  summary             String?
  /// created_at is a String? matching the SQLite DEFAULT (datetime('now')) format.
  /// Omit in create so SQLite default fires (bug-for-bug parity with db-query.js).
  createdAt           String? @map("created_at")

  @@index([createdAt])
  @@map("executor_log")
}

// ---------------------------------------------------------------------------
// observer_log — migration 021 (P2 group 2)
// ---------------------------------------------------------------------------

model ObserverLog {
  id             Int     @id @default(autoincrement())
  errorsAnalyzed Int     @default(0) @map("errors_analyzed")
  issuesCreated  Int     @default(0) @map("issues_created")
  alertsSent     Int     @default(0) @map("alerts_sent")
  summary        String?
  status         String  @default("ok")
  /// created_at is a String? matching the SQLite DEFAULT (datetime('now')) format.
  /// Omit in create so SQLite default fires (bug-for-bug parity with db-query.js).
  createdAt      String? @map("created_at")

  @@index([createdAt])
  @@map("observer_log")
}

// ---------------------------------------------------------------------------
// analysis_cache — migration 006 (token-level analysis cache)
// ---------------------------------------------------------------------------

model AnalysisCache {
  address       String
  chain         String
  symbol        String?
  analysisScore Int?    @map("analysis_score")
  riskScore     Int?    @map("risk_score")
  verdict       String
  tier          String?
  reasoning     String?
  /// expires_at uses SQLite TEXT "YYYY-MM-DD HH:MM:SS" (non-Z) — set via
  /// datetime('now', '+N hours'). Do NOT use ISO-Z timestamps here for
  /// bug-for-bug parity with db-query.js cache-analysis.
  expiresAt     String  @map("expires_at")
  createdAt     String? @map("created_at")

  @@id([address, chain])
  @@index([expiresAt])
  @@map("analysis_cache")
}

// ---------------------------------------------------------------------------
// contract_snapshots — migration 013 (contract safety snapshots)
// ---------------------------------------------------------------------------

model ContractSnapshot {
  id         Int     @id @default(autoincrement())
  address    String
  chain      String
  /// safety_data stored as raw JSON string (bug-for-bug parity with db-query.js add-contract-snapshot)
  safetyData String  @map("safety_data")
  checkedAt  String? @map("checked_at")

  @@index([address, chain], map: "idx_contract_snapshots")
  @@map("contract_snapshots")
}

// ---------------------------------------------------------------------------
// portfolio_sync — migration 008 (on-chain portfolio sync state)
// ---------------------------------------------------------------------------

model PortfolioSync {
  id                  Int     @id @default(autoincrement())
  chain               String
  provider            String
  trigger             String
  status              String
  positionsSynced     Int     @default(0) @map("positions_synced")
  positionsClosed     Int     @default(0) @map("positions_closed")
  positionsDiscovered Int     @default(0) @map("positions_discovered")
  error               String?
  syncedAt            String? @map("synced_at")

  @@map("portfolio_sync")
}

// ---------------------------------------------------------------------------
// trades — migration 001 (included for schema completeness; no module in P1a)
// ---------------------------------------------------------------------------

model Trade {
  id            String  @id
  symbol        String
  address       String
  chain         String
  tier          String
  action        String
  entryPrice    Float?  @map("entry_price")
  exitPrice     Float?  @map("exit_price")
  quantity      Float
  entryDate     String? @map("entry_date")
  exitDate      String? @map("exit_date")
  pnlPercent    Float?  @map("pnl_percent")
  pnlUsd        Float?  @map("pnl_usd")
  exitReason    String? @map("exit_reason")
  analysisScore Int?    @map("analysis_score")
  riskScore     Int?    @map("risk_score")
  narrative     String?
  lesson        String?
  durationDays  Int?    @map("duration_days")
  createdAt     String? @map("created_at")

  @@index([createdAt], name: "idx_trades_created_at")
  @@map("trades")
}
