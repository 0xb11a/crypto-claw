// Prisma schema for CryptoClaw — mirrors legacy scripts/db.js migrations 001-027.
// Source of truth for column types/names: scripts/db.js (read-only; do NOT modify it).
// JSON-string columns are typed as String to match the on-disk SQLite shape.
// The _migrations table used by the legacy db.js migration runner is left out of
// Prisma ownership entirely (Prisma uses _prisma_migrations, legacy uses _migrations
// — different tables, no conflict).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// positions — migration 001 + 008 + 011 + 015 + 016 + 018
// ---------------------------------------------------------------------------

model Position {
  id                   String  @id
  symbol               String
  name                 String?
  address              String
  chain                String
  tier                 String
  entryPrice           Float   @map("entry_price")
  currentPrice         Float?  @map("current_price")
  quantity             Float
  valueUsd             Float?  @map("value_usd")
  percentOfPortfolio   Float?  @map("percent_of_portfolio")
  entryDate            String  @map("entry_date")
  stopLoss             Float   @map("stop_loss")
  takeProfitLevels     String  @map("take_profit_levels") // JSON array (String, not Json)
  narrative            String?
  status               String  @default("open")
  notes                String?
  onchainBalance       Float?  @map("onchain_balance")
  lastSyncedAt         String? @map("last_synced_at")
  exitPrice            Float?  @map("exit_price")
  exitDate             String? @map("exit_date")
  pnlPercent           Float?  @map("pnl_percent")
  pnlUsd               Float?  @map("pnl_usd")
  exitReason           String? @map("exit_reason")
  maxPriceSinceEntry   Float?  @map("max_price_since_entry")
  trailingStopPct      Float?  @map("trailing_stop_pct")
  trailingStopActive   Int     @default(0) @map("trailing_stop_active")
  tpLevelsHit          String  @default("[]") @map("tp_levels_hit") // JSON array
  createdAt            String? @map("created_at")
  updatedAt            String? @map("updated_at")

  @@index([status], name: "idx_positions_status")
  @@index([chain], name: "idx_positions_chain")
  @@index([address, chain], name: "idx_positions_address_chain")
  @@map("positions")
}

// ---------------------------------------------------------------------------
// paper_positions — migration 002 + 018
// ---------------------------------------------------------------------------

model PaperPosition {
  id                   String  @id
  symbol               String
  address              String
  chain                String
  tier                 String
  entryPrice           Float   @map("entry_price")
  currentPrice         Float?  @map("current_price")
  quantity             Float
  valueUsd             Float?  @map("value_usd")
  entryDate            String  @map("entry_date")
  stopLoss             Float   @map("stop_loss")
  takeProfitLevels     String  @map("take_profit_levels") // JSON array
  status               String  @default("open")
  exitPrice            Float?  @map("exit_price")
  exitDate             String? @map("exit_date")
  pnlPercent           Float?  @map("pnl_percent")
  pnlUsd               Float?  @map("pnl_usd")
  exitReason           String? @map("exit_reason")
  maxPriceSinceEntry   Float?  @map("max_price_since_entry")
  trailingStopPct      Float?  @map("trailing_stop_pct")
  trailingStopActive   Int     @default(0) @map("trailing_stop_active")
  tpLevelsHit          String  @default("[]") @map("tp_levels_hit") // JSON array
  createdAt            String? @map("created_at")
  updatedAt            String? @map("updated_at")

  @@index([status], name: "idx_paper_positions_status")
  @@index([address, chain], name: "idx_paper_positions_address_chain")
  @@map("paper_positions")
}

// ---------------------------------------------------------------------------
// orders — migration 012 + 014 + 016 + 022 + 027
// ---------------------------------------------------------------------------

model Order {
  id                   String  @id
  action               String
  symbol               String
  name                 String?
  address              String
  chain                String
  amount               String
  percentOfPortfolio   Float?  @map("percent_of_portfolio")
  tier                 String?
  entryPrice           Float?  @map("entry_price")
  stopLoss             Float?  @map("stop_loss")
  takeProfitLevels     String? @map("take_profit_levels") // JSON array
  analysisScore        Int?    @map("analysis_score")
  riskScore            Int?    @map("risk_score")
  reasoning            String?
  reason               String?
  urgency              String?
  approvedAt           String? @map("approved_at")
  approvedBy           String? @map("approved_by")
  status               String  @default("pending")
  statusReason         String? @map("status_reason")
  statusChangedAt      String? @map("status_changed_at")
  statusChangedBy      String? @map("status_changed_by")
  updatedAt            String? @map("updated_at")
  tgMessageId          Int?    @map("tg_message_id")
  createdAt            String? @map("created_at")

  @@index([status], name: "idx_orders_status")
  @@index([action], name: "idx_orders_action")
  @@index([address, chain], name: "idx_orders_address_chain")
  @@map("orders")
}

// ---------------------------------------------------------------------------
// receipts — migration 012 + 015 + 016
// ---------------------------------------------------------------------------

model Receipt {
  id                   String  @id
  orderId              String  @map("order_id")
  action               String
  symbol               String
  address              String
  chain                String
  amount               Float?
  quantity             Float?
  expectedPrice        Float?  @map("expected_price")
  executedPrice        Float?  @map("executed_price")
  slippage             Float?
  status               String
  safeTxHash           String? @map("safe_tx_hash")
  onchainTxHash        String? @map("onchain_tx_hash")
  safeNonce            Int?    @map("safe_nonce")
  signaturesCollected  Int?    @map("signatures_collected")
  signaturesRequired   Int?    @map("signatures_required")
  gasUsed              String? @map("gas_used")
  error                String?
  notes                String?
  positionId           String? @map("position_id")
  createdAt            String? @map("created_at")

  @@index([orderId], name: "idx_receipts_order_id")
  @@index([status], name: "idx_receipts_status")
  @@map("receipts")
}

// ---------------------------------------------------------------------------
// paper_receipts — migration 012
// ---------------------------------------------------------------------------

model PaperReceipt {
  id                   String  @id
  orderId              String  @map("order_id")
  action               String
  symbol               String
  address              String
  chain                String
  tier                 String?
  proposedPrice        Float   @map("proposed_price")
  quantity             Float?
  amount               Float?
  stopLoss             Float?  @map("stop_loss")
  takeProfitLevels     String? @map("take_profit_levels") // JSON array
  reasoning            String?
  pnlPercent           Float?  @map("pnl_percent")
  pnlUsd               Float?  @map("pnl_usd")
  createdAt            String? @map("created_at")

  @@index([orderId], name: "idx_paper_receipts_order_id")
  @@map("paper_receipts")
}

// ---------------------------------------------------------------------------
// sentinel_alerts — migration 001
// ---------------------------------------------------------------------------

model SentinelAlert {
  id           String  @id
  symbol       String
  chain        String
  alertType    String  @map("alert_type")
  severity     String
  currentPrice Float?  @map("current_price")
  triggerPrice Float?  @map("trigger_price")
  details      String?
  action       String?
  sellAmount   String? @map("sell_amount")
  processed    Int     @default(0)
  processedAt  String? @map("processed_at")
  createdAt    String? @map("created_at")

  @@index([processed], name: "idx_sentinel_alerts_processed")
  @@map("sentinel_alerts")
}

// ---------------------------------------------------------------------------
// heartbeat_state — migration 001
// ---------------------------------------------------------------------------

model HeartbeatState {
  agent      String
  checkType  String  @map("check_type")
  lastRun    String? @map("last_run")

  @@id([agent, checkType])
  @@map("heartbeat_state")
}

// ---------------------------------------------------------------------------
// portfolio_meta — migration 001 (key-value store used across the codebase)
// ---------------------------------------------------------------------------

model PortfolioMeta {
  key       String  @id
  value     String
  updatedAt String? @map("updated_at")

  @@map("portfolio_meta")
}

// ---------------------------------------------------------------------------
// service_audit — new table introduced in P1a (SPEC §9.5, ADR-0018)
// ---------------------------------------------------------------------------

model ServiceAudit {
  id           String  @id @default(cuid())
  ts           String  @default("")
  identity     String
  role         String
  method       String
  path         String
  bodySha256   String  @map("body_sha256")
  bodyRedacted String? @map("body_redacted")
  status       Int
  latencyMs    Int     @map("latency_ms")
  errorKind    String? @map("error_kind")

  @@index([identity, ts])
  @@index([path, ts])
  @@map("service_audit")
}

// ---------------------------------------------------------------------------
// trades — migration 001 (included for schema completeness; no module in P1a)
// ---------------------------------------------------------------------------

model Trade {
  id             String  @id
  symbol         String
  address        String
  chain          String
  tier           String
  action         String
  entryPrice     Float?  @map("entry_price")
  exitPrice      Float?  @map("exit_price")
  quantity       Float
  entryDate      String? @map("entry_date")
  exitDate       String? @map("exit_date")
  pnlPercent     Float?  @map("pnl_percent")
  pnlUsd         Float?  @map("pnl_usd")
  exitReason     String? @map("exit_reason")
  analysisScore  Int?    @map("analysis_score")
  riskScore      Int?    @map("risk_score")
  narrative      String?
  lesson         String?
  durationDays   Int?    @map("duration_days")
  createdAt      String? @map("created_at")

  @@index([createdAt], name: "idx_trades_created_at")
  @@map("trades")
}
