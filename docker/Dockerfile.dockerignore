# Legacy agent runtime — not part of the new monorepo image
agents/
workspace/

# Node modules — never copy from host (platform-specific native binaries;
# the builder stage installs from lockfile inside the image)
node_modules/
scripts/node_modules/
tests/node_modules/
tests/data/

# Runtime data (mounted as volumes)
data/
secrets/

# Env files — never bake into image
.env
.env.*
*.env
!*.env.example

# Git metadata
.git/
.gitignore
.gitmodules

# CI/docs (not needed in prod image)
.github/
docs/

# Build artifacts that shouldn't be double-copied
apps/*/dist/
libs/*/dist/
dist/

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo

# OS artifacts
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test sources — not needed in image
**/*.test.ts
**/*.spec.ts

# Shim-parity baseline — large directory, never needed in image
tests/shim-parity/baseline/

# Coverage output
coverage/

# Nested .dockerignore files (avoid confusion)
**/.dockerignore
