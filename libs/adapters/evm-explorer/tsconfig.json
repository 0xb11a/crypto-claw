{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "module": "CommonJS",
    "moduleResolution": "node",
    "rootDir": "./src",
    "paths": {
      "@cclaw/config": ["../../config/src/index.ts"],
      "@cclaw/logger": ["../../logger/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "../../config" }, { "path": "../../logger" }]
}
