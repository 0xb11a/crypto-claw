    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@cclaw/auth": ["../auth/src/index.ts"],
      "@cclaw/prisma": ["../prisma/src/index.ts"]
