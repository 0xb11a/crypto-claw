{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@cclaw/config": ["../../config/src/index.ts"],
      "@cclaw/chain": ["../../chain/src/index.ts"],
      "@cclaw/system": ["../system/src/index.ts"],
      "@cclaw/notifications": ["../../notifications/src/index.ts"],
      "@cclaw/adapters-safe-tx-service": ["../../adapters/safe-tx-service/src/index.ts"],
      "@cclaw/adapters-squads-rpc": ["../../adapters/squads-rpc/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../config" },
    { "path": "../../chain" },
    { "path": "../system" },
    { "path": "../../notifications" },
    { "path": "../../adapters/safe-tx-service" },
    { "path": "../../adapters/squads-rpc" }
  ]
}
