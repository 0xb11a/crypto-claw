{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "paths": {
      "@cclaw/config": ["../../config/src/index.ts"],
      "@cclaw/prisma": ["../../prisma/src/index.ts"],
      "@cclaw/auth": ["../../auth/src/index.ts"],
      "@cclaw/audit": ["../../audit/src/index.ts"],
      "@cclaw/adapters-birdeye": ["../../adapters/birdeye/src/index.ts"],
      "@cclaw/adapters-zerion": ["../../adapters/zerion/src/index.ts"],
      "@cclaw/adapters-helius": ["../../adapters/helius/src/index.ts"],
      "@cclaw/adapters-evm-explorer": ["../../adapters/evm-explorer/src/index.ts"],
      "@cclaw/system": ["../system/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "../../config" },
    { "path": "../../prisma" },
    { "path": "../../auth" },
    { "path": "../../audit" },
    { "path": "../../adapters/birdeye" },
    { "path": "../../adapters/zerion" },
    { "path": "../../adapters/helius" },
    { "path": "../../adapters/evm-explorer" },
    { "path": "../system" }
  ]
}
