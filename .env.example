# CryptoClaw — Environment Variables
# Copy to .env and fill in your values

# ============================================================
# Fund Identity — Unique per deployment
# ============================================================
SAFE_ID=fund-alpha

# Database path (default: ./data/<SAFE_ID>.db)
# DB_PATH=./data/fund-alpha.db

# ============================================================
# Paper Mode — Simulate trades without touching funds
# ============================================================
PAPER_MODE=false
PAPER_STARTING_BALANCE=10000

# ============================================================
# Agent Memory Backup — Optional git remote for memory push
# ============================================================
# Private repo URL for pushing MEMORY.md and daily logs
# Supports HTTPS (with token) or SSH (mount key into container)
# MEMORY_GIT_REMOTE=https://<token>@github.com/you/crypto-claw-memory.git
# MEMORY_GIT_REMOTE=git@github.com:you/crypto-claw-memory.git

# ============================================================
# OpenClaw Gateway
# ============================================================
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BIND=lan

# ============================================================
# Agent Models
# ============================================================
RESEARCH_MODEL=anthropic/claude-sonnet-4-5-20250929
SENTINEL_MODEL=ollama/deepseek-v3.1:671b-cloud
EXECUTOR_MODEL=ollama/deepseek-v3.1:671b-cloud

# ============================================================
# Ollama Cloud (required for Sentinel/Executor DeepSeek model)
# Create API key at: https://ollama.com/settings/keys
# ============================================================
OLLAMA_API_KEY=

# ============================================================
# Data API Keys
# ============================================================

# Required for contract safety checks
GOPLUS_API_KEY=

# Required for EVM wallet tracking
ETHERSCAN_API_KEY=

# Optional — enhanced Solana data
BIRDEYE_API_KEY=
SOLSCAN_API_KEY=

# DEXScreener (free tier, no key needed)
# DEXSCREENER_API_KEY=

# CoinGecko (free tier, no key needed for basic data)
# COINGECKO_API_KEY=

# ============================================================
# Safe Wallet — Required for Executor Agent
# ============================================================

# Safe wallet addresses per chain
SAFE_ADDRESS_ETH=
SAFE_ADDRESS_BASE=
# SAFE_ADDRESS_SOL=

# Private key for the Executor's signer (NEVER commit this)
SAFE_SIGNER_KEY=

# RPC endpoints
RPC_ETH=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_SOL=https://api.mainnet-beta.solana.com
