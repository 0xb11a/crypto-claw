# CryptoClaw — Environment Variables
# Copy to .env and fill in your values

# ============================================================
# Fund Identity — Unique per deployment
# ============================================================
SAFE_ID=fund-alpha

# Database path (default: ./data/<SAFE_ID>.db)
# DB_PATH=./data/fund-alpha.db

# ============================================================
# Paper Mode — Simulate trades without touching funds
# ============================================================
PAPER_MODE=false
PAPER_STARTING_BALANCE=10000
# Per-chain paper starting balance (overrides PAPER_STARTING_BALANCE for specific chains)
# PAPER_STARTING_BALANCE_BASE=5000
# PAPER_STARTING_BALANCE_SOLANA=5000
# PAPER_STARTING_BALANCE_ETHEREUM=5000

# Auto-approve BUY orders without human confirmation (real mode only)
# Telegram notifications still fire. No effect when PAPER_MODE=true.
# PR 1.5: when set to true, you MUST also set AUTO_APPROVE_BUY_MAX_USD —
# the entrypoint refuses to start without a positive per-trade USD cap.
# Orders above the cap fall back to status='pending' (human-gated).
AUTO_APPROVE_BUY=false
# Per-trade auto-approve cap in USD. Required when AUTO_APPROVE_BUY=true.
# Suggested starting value: 50. Tune up after a paper-mode soak period.
# AUTO_APPROVE_BUY_MAX_USD=50

# PR 2.1 — Per-tier absolute USD ceilings on BUY orders, enforced in
# process-order.js. Defangs cash-balance poisoning: even if cash row
# is forged, an attacker can't drain more than the tier cap per trade.
# Override the chains.js defaults (200 / 500 / 2000) per fund. Apply
# to both real and paper modes (defense-in-depth equally).
# TIER_MAX_USD_MOONSHOT=200
# TIER_MAX_USD_CONVICTION=500
# TIER_MAX_USD_BASE=2000

# PR 2.2 — Pre-sign safety re-check. process-order.js re-runs
# token-metrics.js + check-contract.js immediately before signing each
# buy and refuses on honeypot / pausable / top-holder>30% / liquidity
# <$5k that emerged between proposal and execution. Set this to "true"
# ONLY during a genuine GoPlus / DEXScreener outage to keep buys
# moving. Default unset = checks enforced.
# SKIP_PRESIGN_RECHECK=false

# PR 2.4 — Pre-execute on-chain cash reconciliation. process-order.js
# reads the actual Safe/Squads vault USDC balance and refuses any buy
# whose DB cash drifts >1% from on-chain. Defense against
# portfolio_meta cash-row poisoning. Skipped in paper mode. Set this
# to "true" ONLY during a genuine RPC outage.
# SKIP_CASH_RECONCILE=false

# PR 2.5 — Scoped ERC-20 approvals (EVM only). execute-trade-evm.js
# now approves quote_amount * (1 + APPROVAL_MARGIN_PCT/100) instead
# of maxUint256, so a future 1inch router compromise can only drain
# the in-flight trade amount + margin, not the full Safe balance.
# Default 5%. Use 10 for high-volatility assets where price moves
# sharply between quote and execution. Costs ~$3 extra gas per buy.
# NOTE: existing Safes that approved maxUint256 under the legacy
# code path retain that approval — manually revoke via the Safe UI
# to realize the full benefit.
# APPROVAL_MARGIN_PCT=5

# PR 2.7 — Independent price-oracle cross-check at signing time.
# execute-trade-{evm,solana}.js fetches a reference price from
# DEXScreener + Birdeye (2-of-2 agreement, ≤2% drift between them)
# and refuses if the aggregator quote drifts >5% from that average.
# Catches aggregator-side quote manipulation. Set this to "true"
# ONLY during a genuine source outage to keep trades moving.
# Requires BIRDEYE_API_KEY for the Birdeye half.
# SKIP_PRICE_ORACLE=false

# PR 2.8 — RPC hostname allowlist. The executor (and onchain-balance)
# refuses to use an RPC URL whose hostname isn't in the chains.js
# allowlist (Alchemy / Infura / Helius / etc.). Defangs RPC env-var
# tampering — front-running, censorship, fake state reads.
# Modes:
#   strict (default) — mismatch throws, refuse to execute
#   warn  — log [suspicious-rpc] but continue (for the first 48h
#          after rollout, until you confirm your RPC is in the list)
#   skip  — disable check entirely (genuine new provider, or test)
# RPC_VALIDATION_MODE=strict

# PR 3.2 — Multisig governance drift expectations. Set these at fund
# setup; a daily cron (entrypoint.sh:run_governance_drift_loop) reads
# the live Safe / Squads config and fires a critical rug_warning
# Telegram alert if anything drifts. Owner-add or threshold-lower is
# the highest-leverage compromise possible — silent, no immediate
# drain, but grants permanent unilateral control. Detect within 24h.
#
# EVM: per-chain (BASE, ETHEREUM). Owners + modules comma-separated,
# threshold integer. Modules typically empty (Safe modules can
# bypass the multisig).
# EXPECTED_SAFE_OWNERS_BASE=0xowner1,0xowner2,0xowner3
# EXPECTED_SAFE_THRESHOLD_BASE=2
# EXPECTED_SAFE_MODULES_BASE=
# EXPECTED_SAFE_OWNERS_ETHEREUM=0xowner1,0xowner2,0xowner3
# EXPECTED_SAFE_THRESHOLD_ETHEREUM=2
# EXPECTED_SAFE_MODULES_ETHEREUM=
#
# Solana Squads:
# EXPECTED_SQUADS_MEMBERS=Pubkey1,Pubkey2,Pubkey3
# EXPECTED_SQUADS_THRESHOLD=2

# ============================================================
# Active Chains — Comma-separated: base, solana, ethereum
# Solana sync exits gracefully if Squads wallet is not configured
# ============================================================
ACTIVE_CHAINS=base,ethereum,solana

# ============================================================
# Agent Memory Backup — Optional git remote for memory push
# ============================================================
# Private repo URL for pushing MEMORY.md and daily logs
# Supports HTTPS (with token) or SSH (mount key into container)
# MEMORY_GIT_REMOTE=https://<token>@github.com/you/crypto-claw-memory.git
# MEMORY_GIT_REMOTE=git@github.com:you/crypto-claw-memory.git

# ============================================================
# Observer Agent — GitHub Integration
# ============================================================
# Private repo for issue tracking (Observer agent creates issues here)
# Use a private repo until you're confident redaction is bulletproof
# OBSERVER_ISSUES_REPO=you/crypto-claw-issues
# GH_TOKEN=ghp_...

# ============================================================
# OpenClaw Gateway
# ============================================================
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_BIND=lan

# ============================================================
# Agent Models
# ============================================================
RESEARCH_MODEL=openai-codex/gpt-5.5
SENTINEL_MODEL=openai-codex/gpt-5.5
EXECUTOR_MODEL=openai-codex/gpt-5.5
OBSERVER_MODEL=openai-codex/gpt-5.5


# Fallback models when primary model provider fails
SENTINEL_MODEL_FALLBACK=anthropic/claude-haiku-4-5-20251001
EXECUTOR_MODEL_FALLBACK=anthropic/claude-haiku-4-5-20251001

# Emergency mode: executor activates after N consecutive failures (default: 3)
EMERGENCY_AFTER=3

# ============================================================
# Channels — Telegram (optional)
# ENABLE_CHANNELS=true enables chat interaction with agents via Telegram
# Without ENABLE_CHANNELS, Telegram is used for outbound alerts only
# ============================================================
ENABLE_CHANNELS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram security — your numeric Telegram user ID (get it from @userinfobot)
# When set, only your messages trigger agent responses in the group
TELEGRAM_OWNER_ID=

# Telegram approval bot — inline Approve/Reject buttons for buy orders
# Create a separate bot via @BotFather, add it to your supergroup
# When set, pending buy orders get Telegram messages with Approve/Reject buttons
TELEGRAM_APPROVAL_BOT_TOKEN=

# Telegram supergroup forum topics (optional)
# Create a supergroup, enable Topics, create 8 topics, then run:
#   TELEGRAM_BOT_TOKEN=xxx TELEGRAM_CHAT_ID=xxx node scripts/telegram-get-topics.js
# to discover thread IDs for each topic.
TG_TOPIC_RESEARCH=
TG_TOPIC_SENTINEL=
TG_TOPIC_EXECUTOR=
TG_TOPIC_ALERTS=
TG_TOPIC_SYSTEM=
TG_TOPIC_OBSERVER=
TG_TOPIC_PORTFOLIO=
TG_TOPIC_APPROVALS=
PORTFOLIO_REPORT_HOUR=0

# ============================================================
# OpenAI — all four agents default to GPT-5.5 via Codex OAuth
#
# Option 1 (preferred): Codex OAuth with ChatGPT subscription (flat monthly fee)
#   One-time setup: docker compose exec crypto-claw openclaw models auth login --provider openai-codex
#   Requires: ChatGPT Plus/Pro/Team subscription
#   Auth managed by OpenClaw — auto-refreshes tokens
#
# Option 2 (fallback): Static API key (per-token billing)
#   Create API key at: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=

# ============================================================
# Ollama Cloud (optional — alternative model provider)
# Create API key at: https://ollama.com/settings/keys
# ============================================================
OLLAMA_API_KEY=

# ============================================================
# Data API Keys
# ============================================================

# Required for contract safety checks
GOPLUS_API_KEY=

# Required for EVM wallet tracking (one per chain)
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# Solana wallet tracking + token data (set at least one)
SOLSCAN_API_KEY=
HELIUS_API_KEY=

# Wallet scoring (EVM PnL via Zerion — free 3k calls/day)
ZERION_API_KEY=

# Optional — enhanced Solana token data + wallet PnL scoring
BIRDEYE_API_KEY=

# DeBank Cloud API (portfolio sync — on-chain balance reading)
DEBANK_API_KEY=

# 1inch Swap API (required for live trade execution)
# Get key at: https://portal.1inch.dev
ONEINCH_API_KEY=

# DEXScreener (free tier, no key needed)
# DEXSCREENER_API_KEY=

# CoinGecko (free tier, no key needed for basic data)
# COINGECKO_API_KEY=

# ============================================================
# Safe Wallet — Required for Executor Agent
# ============================================================

# Safe wallet addresses per chain (EVM)
SAFE_ADDRESS_ETH=
SAFE_ADDRESS_BASE=

# Private key for the Executor's EVM signer (NEVER commit this)
SAFE_SIGNER_KEY=

# RPC endpoints
RPC_ETH=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_SOL=https://api.mainnet-beta.solana.com

# ============================================================
# Squads Multisig — Required for Executor on Solana
# ============================================================
SQUADS_VAULT_ADDRESS=            # Vault address (base58) — use this if you know your vault address directly
SQUADS_MULTISIG_ADDRESS=         # Multisig PDA (base58) — vault is derived from this if SQUADS_VAULT_ADDRESS not set
SQUADS_SIGNER_KEY=               # Signer private key (base58, NEVER commit)

# Jupiter (free tier, optional key for higher rate limits)
# JUPITER_API_KEY=
